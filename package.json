{
  "name": "securiself",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:backend": "pnpm --filter api-backend test",
    "test:platform": "pnpm --filter securiself-platform test",
    "test:e2e:prepare": "pnpm exec tsx tests/e2e/setup/run-prepare-cli.ts",
    "test:e2e": "pnpm test:e2e:prepare && playwright test --grep-invert \"@a11y|@evidence|@sprint2-evidence|@sprint2-candidate-b-review\"",
    "test:e2e:headed": "pnpm test:e2e:prepare && playwright test --headed --grep-invert \"@a11y|@evidence|@sprint2-evidence|@sprint2-candidate-b-review\"",
    "test:e2e:ui": "pnpm test:e2e:prepare && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "pnpm test:e2e:prepare && playwright test --grep \"@a11y\"",
    "test:evidence:screenshots": "pnpm test:e2e:prepare && playwright test --grep \"@evidence\"",
    "test:candidate-b-review": "pnpm test:e2e:prepare && playwright test --grep \"@sprint2-candidate-b-review\"",
    "test:quality": "pnpm lint && pnpm check-types",
    "test:all": "pnpm test:backend && pnpm test:platform && pnpm test:e2e && pnpm test:a11y && pnpm test:quality"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "dotenv": "^17.4.2",
    "prettier": "^3.7.4",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
