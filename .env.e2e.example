# Copy to `.env.e2e` and fill with dedicated test/E2E values.
# Never point these at your development or production database.

# Prefer E2E_DATABASE_URL; TEST_DATABASE_URL is accepted as a fallback.
E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/securiself_e2e?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/securiself_e2e?schema=public"

NODE_ENV=test
SECURISELF_E2E=true
ALLOW_E2E_DB_RESET=true

JWT_SECRET="replace-with-a-secure-e2e-secret"
JWT_EXPIRES_IN=30d
AUTH_CODE_TTL_MINUTES=5
ACCESS_TOKEN_TTL_HOURS=1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:8080
# Fictional E2E fixture client (mirrors tests/e2e/fixtures/test-data.ts; not a real credential)
NEXT_PUBLIC_CLIENT_ID=scs_e2e_prymecab_client
CLIENT_SECRET=scs_secret_e2e_prymecab_test_only
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3001/api/auth/callback
NEXT_PUBLIC_SECURISELF_AUTHORIZE_URL=http://localhost:3000/oauth/authorize

# Deterministic fictional identity owner (seeded by tests/e2e/setup/prepare-e2e.ts;
# mirrors tests/e2e/fixtures/test-data.ts; not a real account)
E2E_USER_EMAIL=e2e.owner@securiself.test
E2E_USER_PASSWORD=E2eOwnerPass123!

# Optional: reuse already-running local servers that were started with this env
# E2E_REUSE_SERVERS=true
