# Copy to `.env.e2e` and fill with dedicated E2E values.
# Never point these at your development or production database: the suite
# truncates and reseeds it before every test.

# Prefer E2E_DATABASE_URL; TEST_DATABASE_URL is accepted as a fallback.
E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/securiself_e2e?schema=public"

NODE_ENV=test
SECURISELF_E2E=true
ALLOW_E2E_DB_RESET=true

JWT_SECRET="replace-with-a-local-e2e-secret"
JWT_EXPIRES_IN=30d
AUTH_CODE_TTL_MINUTES=5
ACCESS_TOKEN_TTL_HOURS=1

# The seeded owner, Contexts and PrymeCab client (a fictional, test-only
# credential) are defined in tests/e2e/fixtures/test-data.ts.

# Optional: reuse already-running local servers that were started with this env.
# E2E_REUSE_SERVERS=true
