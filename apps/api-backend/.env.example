# PostgreSQL connection string used by Prisma and the pg driver adapter
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/securiself?schema=public"

# HTTP server
PORT=8080
NODE_ENV=development

# Session JWT (user authentication)
JWT_SECRET="replace-with-a-secure-local-secret"
JWT_EXPIRES_IN=30d

# OAuth-like flow lifetimes
AUTH_CODE_TTL_MINUTES=5
ACCESS_TOKEN_TTL_HOURS=1

# Google Identity Services: OAuth 2.0 "Web application" client ID.
# Must be the SAME value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the platform app.
# Leave empty to disable Google sign-in (email/password keeps working).
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Separate database used by the test suite (integration tests truncate it between tests)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/securiself_test?schema=public"
