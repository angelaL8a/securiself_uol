# Copy to `.env.local`. Use the client registered for PrymeCab in the
# SecuriSelf Console (Clients → Register an application).

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SECURISELF_AUTHORIZE_URL=http://localhost:3000/oauth/authorize

# Must exactly match the redirect URI registered for the client.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3001/api/auth/callback

NEXT_PUBLIC_CLIENT_ID=your-securiself-client-id

# Server-side only: read by the callback route handler, never sent to the browser.
CLIENT_SECRET=your-securiself-client-secret
