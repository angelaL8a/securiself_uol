# Copy to `.env.local`.

# Base URL of the SecuriSelf API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Identity Services OAuth 2.0 "Web application" client ID.
# Must match GOOGLE_CLIENT_ID in apps/api-backend/.env.
# Leave empty to hide the Google button (email/password still works).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
